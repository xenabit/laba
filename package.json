{
  "name": "laba",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run optimize:svg && vite build",
    "prod": "vite preview --port 3001 --open",
    "optimize:svg": "svgo -f src/assets/images -r --config=svgo.config.js",
    "optimize:svg:check": "svgo -f src/assets/images -r -n --config=svgo.config.js",
    "convert-images": "node convert-images.js",
    "convert-videos": "node convert-videos.js",
    "convert:heavy": "npm run --if-present convert-images && npm run --if-present convert-videos"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "framer-motion": "^11.18.2",
    "fslightbox-react": "^1.7.6",
    "gsap": "^3.12.5",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^9.13.0",
    "react-router-dom": "^6.26.2",
    "react-spring": "^9.7.4",
    "react-transition-group": "^4.4.5",
    "swiper": "^11.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.25.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "fluent-ffmpeg": "^2.1.3",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "prettier-plugin-css-order": "^2.1.2",
    "sass": "^1.89.2",
    "sharp": "^0.34.3",
    "sharp-cli": "^5.2.0",
    "svgo": "^4.0.0",
    "vite": "^7.1.3",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^1.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-static-copy": "^3.1.2",
    "vite-plugin-svgr": "^4.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-range-requests": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
